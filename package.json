{
  "name": "hono-laravel",
  "version": "0.1.0",
  "description": "Hono + TypeScript + Drizzle template with a Laravel-inspired directory structure, built for Cloudflare Workers.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "typegen": "wrangler types worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply sistem-ujian-segak --local",
    "db:migrate:remote": "wrangler d1 migrations apply sistem-ujian-segak --remote",
    "db:push": "drizzle-kit push",
    "db:seed": "wrangler d1 execute sistem-ujian-segak --local --file=./src/database/seeders/seed.sql",
    "db:seed:remote": "wrangler d1 execute sistem-ujian-segak --remote --file=./src/database/seeders/seed.sql",
    "setup:d1": "powershell -ExecutionPolicy Bypass -File ./scripts/setup.ps1",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.0",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^20.11.0",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.119.0"
  }
}
