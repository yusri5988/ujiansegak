{
  "name": "hono-laravel",
  "version": "0.1.0",
  "description": "Hono + TypeScript + Drizzle template with a Laravel-inspired directory structure, built for Cloudflare Workers.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run build:frontend && concurrently --kill-others --names frontend,worker --prefix-colors cyan,green \"npm run dev:frontend\" \"npm run dev:worker\"",
    "dev:frontend": "vite --config vite.config.ts",
    "dev:worker": "wrangler dev --ip 127.0.0.1 --port 8787",
    "build:frontend": "vite build --config vite.config.ts",
    "deploy": "npm run build:frontend && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "typegen": "wrangler types worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:push": "drizzle-kit push",
    "db:seed": "wrangler d1 execute DB --local --file=./src/database/seeders/seed.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=./src/database/seeders/seed.sql",
    "setup:d1": "powershell -ExecutionPolicy Bypass -File ./scripts/setup.ps1",
    "test": "vitest run",
    "test:teacher-daily-log": "vitest run tests/teacher-daily-log.test.ts",
    "test:workers": "vitest run --config vitest.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^20.11.0",
    "concurrently": "^9.2.5",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.4.0",
    "vite": "^8.3.5",
    "vitest": "^2.0.0",
    "wrangler": "^4.119.0"
  }
}
